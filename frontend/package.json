{
	"name": "nearbox-frontend",
	"private": true,
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "bun run agents:sync && vite dev",
		"build": "bun run agents:sync && vite build && node scripts/postbuild-relative-paths.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"agents:sync": "node scripts/sync-agents.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"world:add": "node scripts/world-add.mjs",
		"world:scan": "node scripts/world-scan.mjs",
		"world:build": "node scripts/world-build.mjs",
		"world:externalize": "node scripts/world-externalize.mjs",
		"world:check": "node scripts/world-check.mjs",
		"world:sync": "node scripts/world-sync.mjs",
		"world:compress": "node scripts/world-compress.mjs",
		"characters:compress": "node scripts/characters-compress.mjs",
		"characters:check": "node scripts/characters-check.mjs",
		"assets:compress": "node scripts/assets-compress.mjs",
		"assets:check": "node scripts/assets-check.mjs",
		"race:check": "node scripts/verify-race-track.mjs",
		"npcs:check": "bun scripts/verify-npcs.ts",
		"audio:check": "bun scripts/verify-audio-recipes.ts",
		"waves:check": "node scripts/verify-waves-arena.mjs",
		"waves:terrain": "bun scripts/verify-waves-terrain.mjs",
		"waves:fire": "bun scripts/verify-waves-fire.mjs",
		"waves:rock": "bun scripts/verify-waves-rock.mjs",
		"waves:aim": "bun scripts/verify-waves-aim.mjs",
		"parkour:aim": "bun scripts/verify-parkour-aim.mjs",
		"dm:check": "bun scripts/verify-deathmatch-arena.mjs",
		"dm:balance": "bun scripts/verify-deathmatch-balance.mjs",
		"dm:match": "bun scripts/verify-deathmatch-match.mjs",
		"parkour:check": "node scripts/verify-parkour.mjs",
		"parkour:build": "node scripts/world-build.mjs parkour",
		"map:build": "node scripts/world-build.mjs map",
		"map:check": "node scripts/world-check.mjs map",
		"map:compress": "node scripts/world-compress.mjs map",
		"crypt:build": "node scripts/world-build.mjs crypt",
		"crypt:check": "node scripts/world-check.mjs crypt",
		"roadmap:build": "node scripts/world-build.mjs roadmap",
		"roadmap:check": "node scripts/world-check.mjs roadmap",
		"barnsiege:build": "node scripts/world-build.mjs barnsiege",
		"barnsiege:check": "node scripts/world-check.mjs barnsiege",
		"islas-ciudad:build": "node scripts/world-build.mjs islas-ciudad",
		"islas-ciudad:check": "node scripts/world-check.mjs islas-ciudad",
		"royale:build": "bun scripts/build-royale-map.mjs",
		"royale:check": "bun scripts/verify-royale.mjs",
		"royale:balance": "bun scripts/verify-royale-balance.mjs",
		"royale:match": "bun scripts/verify-royale-match.mjs",
		"royale:bots": "bun scripts/verify-royale-bots.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@threlte/gltf": "3.1.0",
		"esbuild": "^0.28.2",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@auth0/auth0-spa-js": "^2.30.0",
		"@dimforge/rapier3d-compat": "^0.21.0",
		"@fast-auth-near/browser-sdk": "^1.4.2",
		"@fast-auth-near/javascript-provider": "^1.4.1",
		"@lucide/svelte": "^1.65.0",
		"@near-wallet-selector/core": "10.1.4",
		"@near-wallet-selector/meteor-wallet": "10.1.4",
		"@series-inc/rundot-game-sdk": "^5.34.0",
		"@threlte/core": "^8.6.1",
		"@threlte/extras": "^9.22.4",
		"@threlte/rapier": "^3.5.1",
		"@types/three": "^0.186.0",
		"buffer": "^6.0.3",
		"hls.js": "^1.6.16",
		"lucide-svelte": "^1.0.1",
		"near-api-js": "5.1.1",
		"three": "^0.186.1"
	}
}
