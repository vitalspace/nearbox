const REWARD_BY_ID = new Map(REWARD_CATALOG.map((entry) => [entry.catalogId, entry]));

export function rewardById(catalogId: string): RewardCatalogEntry | null {
	return REWARD_BY_ID.get(catalogId) ?? null;
}

/**
 * Catálogos que solo pueden mintearse desde `/rewards/claim`.
 *
 * Son las medallas y trofeos nuevos de §11.3. Los equipables (`pistol-gold`,
 * `vampire`, etc.) ya existen en la tienda y conservan su camino normal.
 */
export const REWARD_ONLY_CATALOGS: readonly string[] = REWARD_CATALOG.map(
	(entry) => entry.catalogId
);

const REWARD_ONLY = new Set(REWARD_ONLY_CATALOGS);

export function isRewardCatalog(catalogId: string): boolean {
	return REWARD_ONLY.has(catalogId);
}

/**
 * Topes de los equipables existentes que también son recompensa (SPEC-045
 * §11.3). No se añaden al catálogo on-chain: ya existen en la tienda y
 * conservan sus topes.
 */
const EQUIPPABLE_REWARD_CAPS: Readonly<
	Record<string, { cap: number; perAccountCap: number }>
> = {
	'pistol-gold': { cap: 25, perAccountCap: 3 },
	'bazooka-gold': { cap: 25, perAccountCap: 3 },
	'mp5-gold': { cap: 25, perAccountCap: 3 },
	vampire: { cap: 50, perAccountCap: 5 },
	'magic-broom': { cap: 25, perAccountCap: 3 },
	crown: { cap: 50, perAccountCap: 5 }
};

/** Tope de un catálogo de recompensa, sea medalla, trofeo o equipable. */
export function rewardCapFor(
	catalogId: string
): { cap: number; perAccountCap: number } | null {
	const entry = REWARD_BY_ID.get(catalogId);

	if (entry) {
		return { cap: entry.cap, perAccountCap: entry.perAccountCap };
	}

	return EQUIPPABLE_REWARD_CAPS[catalogId] ?? null;
}

/** IDs de catálogo que el jugador debe poseer para desbloquear una misión. */
export function missionGateCatalogIds(mission: ProgressionMission): string[] {
	return (mission.unlock.nft ?? []).map((entry) => entry.catalogId);
}

export function maxTierValue(tier: ProgressionTier): number {
	return PROGRESSION_TIERS.indexOf(tier);
}

/**
 * FNV-1a de 32 bits sobre la forma canónica del catálogo. Es estable entre
 * Node, Bun y el navegador; no necesita `crypto`.
 */
export function catalogFingerprint(
	missions: readonly ProgressionMission[] = PROGRESSION_MISSIONS
): string {
	const canonical = missions.map((mission) => [
		mission.id,
		mission.track,
		mission.tier,
		mission.objective,
		mission.unlock,
		mission.reward,
		mission.serverAttested ? 1 : 0
	]);

	const text = JSON.stringify(canonical);
	let hash = 0x811c9dc5;

	for (let index = 0; index < text.length; index += 1) {
		hash ^= text.charCodeAt(index);
		hash = Math.imul(hash, 0x01000193) >>> 0;
	}

	return hash.toString(16).padStart(8, '0');
}
